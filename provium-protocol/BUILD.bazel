load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "BUILD.bazel",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
            "meta/**",
        ],
        allow_empty = True,
    ) + [
        "BUILD.bazel",
        "Cargo.toml",
    ],
)

rust_library(
    name = "library",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"] + glob(
        ["meta/**"],
        allow_empty = True,
    ),
    crate_features = [],
    crate_name = "provium_protocol",
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.1.0",
    deps = [] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit-tests",
    size = "medium",
    crate = ":library",
    deps = all_crate_deps(normal_dev = True),
)
