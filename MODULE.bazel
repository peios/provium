module(
    name = "provium",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_rustc_flags = [
        "-Cdebuginfo=2",
        "-Cstrip=none",
        "-Clink-arg=-Wl,-z,relro",
        "-Clink-arg=-Wl,-z,now",
        "--remap-path-prefix=$${output_base}=/usr/src/debug/dev.peios.provium/.build",
        "--remap-path-prefix=$${pwd}=/usr/src/debug/dev.peios.provium",
        "--remap-path-prefix=$${exec_root}=/usr/src/debug/dev.peios.provium",
        "--remap-path-prefix=external=/usr/src/debug/dev.peios.provium/external",
        "--remap-path-prefix=.=/usr/src/debug/dev.peios.provium",
    ],
    extra_target_triples = [],
    sha256s = {
        "rustc-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e974f036b28565f37c0f3bd92ddefa809bee16c04f9dcf07b9ed96e05aaaf7c4",
        "clippy-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e167f333be24e1d5eea56ea563c7def0aa0bd613f5ce3445976c93b0288799d1",
        "cargo-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "ea1de9f9e23107d97ee2b41a72c552f34064a593da503789218387aee59f3ba4",
        "llvm-tools-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "56d58ca2dfa848359ab23c872791509c6f592448d2f6c146ed530ec50ee45371",
        "rust-std-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "fa3ff450172a16c026944030230c5069947af93c728d9179971d44e5e0cfb561",
    },
    versions = ["1.98.1"],
)
rust.repository_set(
    name = "provium_musl",
    edition = "2021",
    exec_triple = "x86_64-unknown-linux-gnu",
    extra_rustc_flags = [
        "-Cdebuginfo=2",
        "-Cstrip=none",
        "-Crelocation-model=pic",
        "-Clink-self-contained=yes",
        "-Clink-arg=-static-pie",
        "-Clink-arg=-Wl,-z,relro",
        "-Clink-arg=-Wl,-z,now",
        "--remap-path-prefix=$${output_base}=/usr/src/debug/dev.peios.provium/.build",
        "--remap-path-prefix=$${pwd}=/usr/src/debug/dev.peios.provium",
        "--remap-path-prefix=$${exec_root}=/usr/src/debug/dev.peios.provium",
        "--remap-path-prefix=external=/usr/src/debug/dev.peios.provium/external",
        "--remap-path-prefix=.=/usr/src/debug/dev.peios.provium",
    ],
    sha256s = {
        "rustc-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e974f036b28565f37c0f3bd92ddefa809bee16c04f9dcf07b9ed96e05aaaf7c4",
        "rust-std-1.98.1-x86_64-unknown-linux-musl.tar.xz": "bd9f35880de21dab0e387e84009c00001ae7836a4ba565cb16823f13f75f325f",
        "cargo-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "ea1de9f9e23107d97ee2b41a72c552f34064a593da503789218387aee59f3ba4",
        "clippy-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e167f333be24e1d5eea56ea563c7def0aa0bd613f5ce3445976c93b0288799d1",
        "llvm-tools-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "56d58ca2dfa848359ab23c872791509c6f592448d2f6c146ed530ec50ee45371",
    },
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//build:libc-musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:provium_musl__x86_64-unknown-linux-musl__stable", "@rust_toolchains//:rust_linux_x86_64__x86_64-unknown-linux-gnu__stable")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    build_script_env = {"CFLAGS": "-fcf-protection=full"},
    compile_data_glob = [
        "Cargo.toml",
        "LICENSE*",
        "LICENCE*",
        "COPYING*",
        "NOTICE*",
        "UNLICENSE*",
    ],
    crate = "*",
)

# lua-src normally embeds the compile sandbox's absolute directory. Pass
# its declared source manifest to the separate mlua build-script action.
crate.annotation(
    additive_build_file_content = """
exports_files(["Cargo.toml"])
filegroup(name = "lua-sources", srcs = glob(["lua-5.4.7/**"]) + ["Cargo.toml"])
""",
    crate = "lua-src",
    patch_args = ["-p1"],
    patches = ["//build:lua-source-location.patch"],
    repositories = ["crates"],
)
crate.annotation(
    build_script_data = [
        "@crates__lua-src-547.0.0//:lua-sources",
        "@crates__lua-src-547.0.0//:Cargo.toml",
    ],
    build_script_env = {"PEIOS_LUA_SOURCE_MANIFEST": "$(execpath @crates__lua-src-547.0.0//:Cargo.toml)"},
    crate = "mlua-sys",
    repositories = ["crates"],
)
crate.render_config(
    platforms_template = "@@//build:{triple}",
    repositories = ["crates"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "crates")

native_rust = use_repo_rule("//build:native-rust.bzl", "native_rust")

native_rust(name = "peios_rust")

native_rust(
    name = "peios_musl",
    target_constraint = "//build:libc-musl",
    target_triple = "x86_64-unknown-linux-musl",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "buildifier",
    executable = True,
    sha256 = "31b6a8aa1e5c746696788f428729701770ad91925873d8256cb885c60e12c77e",
    urls = ["https://github.com/bazel-contrib/buildtools/releases/download/v10.1.0/buildifier-linux-amd64"],
)

single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//build:rules-rust-system-libraries.patch"],
    version = "0.74.0",
)

crate.from_cargo(
    name = "ppk_crates",
    cargo_lockfile = "//vendor/ppk:Cargo.lock",
    manifests = ["//vendor/ppk:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "ppk_crates")
