load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//build:checks.bzl", "host_test")
load(":build.bzl", "provium_stage")
load(":names.bzl", "PACKAGE_NAMES")
load(":package.bzl", "package_store_test", "provium_package")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

rust_binary(
    name = "check-blobs",
    srcs = ["check_blobs.rs"],
    edition = "2024",
    target_compatible_with = ["//build:libc-gnu"],
    deps = [
        "@ppk_crates//:anyhow",
        "@ppk_crates//:sha2",
        "@ppk_crates//:zstd",
    ],
)

provium_stage(
    name = "stage",
    components = {
        "//:provium": "provium",
        "//:provium-coverage": "provium-coverage",
        "//:agent-static": "provium-agent",
    },
    data = ["//:package-data"],
    driver = "stage.py",
    drivers = [
        "stage.py",
        "licences.py",
        "validate.py",
    ],
    native = select({
        "//build:native": True,
        "//conditions:default": False,
    }),
)

[
    provium_package(
        name = name,
        srcs = ["//:package-data"],
        definition = "definitions/" + name + ".json",
        stage = ":stage",
    )
    for name in PACKAGE_NAMES
]

provium_package(
    name = "provium-source",
    srcs = ["//:package-sources"],
    source = True,
)

filegroup(
    name = "all",
    srcs = [":" + name for name in PACKAGE_NAMES] + [":provium-source"],
)

package_store_test(
    name = "store-test",
    size = "small",
    srcs = [
        "assembly.py",
        "package.py",
    ],
    main = "test_store.py",
)

host_test(
    name = "assembly-test",
    size = "small",
    command = "exec python3 packages/test_assembly.py",
    data = [
        "assembly.py",
        "test_assembly.py",
    ],
)

filegroup(
    name = "definitions",
    srcs = glob(["definitions/*.json"]),
)

filegroup(
    name = "build-files",
    srcs = ["BUILD.bazel"] + glob(["*.bzl"]),
)

host_test(
    name = "licences-test",
    size = "small",
    command = "exec python3 packages/test_licences.py",
    data = [
        "licences.py",
        "test_licences.py",
    ],
)
