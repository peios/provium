# The provium workspace: pekit builds it with the gcc library's Bootlin C
# toolchain and the rust library's pinned Rust, and makes and tests the
# agent's archives with the python library's pinned Python, whose test
# extracts them with the buildenv library's busybox.
import Toolchain::* from "github.com/gcslib/buildenv"
import Toolchain::* from "github.com/gcslib/gcc"
import Toolchain::* from "github.com/gcslib/python"
import Toolchain::* from "github.com/gcslib/rust"
import Toolchain from toolchain

pekitconf = {
    toolchains = [Toolchain::C gcc_x86_64, Toolchain::Rust rust_1_98, Toolchain::Python python_3_14, Toolchain::BuildEnv busybox_x86_64]
}
